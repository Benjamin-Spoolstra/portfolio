---
import { getCollection } from "astro:content";

const catLabel: Record<string, string> = {
  offensive: "Offensive",
  defensive: "Defensive",
  grc: "GRC",
  tooling: "Tooling",
};
const catBadge: Record<string, string> = {
  offensive: "crit",
  defensive: "high",
  grc: "med",
  tooling: "low",
};

const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<section class="section" id="projects">
  <div class="wrap">
    <div class="sec-head"><span class="tag">01</span><h2>Projects</h2></div>
    <div class="grid">
      {
        projects.map((p) => (
          <a class="card" href={`/projects/${p.id}/`}>
            <div class="top">
              <h3>{p.data.title}</h3>
              <span class={`badge ${catBadge[p.data.category]}`}>
                {catLabel[p.data.category]}
              </span>
            </div>
            <p>{p.data.summary}</p>
            <div class="tags">
              {p.data.tools.slice(0, 5).map((t) => (
                <span>{t}</span>
              ))}
            </div>
            <div class="meta">
              <span>{p.data.skills[0]}</span>
              <span class="go">read →</span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
