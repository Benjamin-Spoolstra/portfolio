---
import { certifications } from "../data/site.ts";
---

<section class="section" id="certs">
  <div class="wrap">
    <div class="sec-head"><span class="tag">03</span><h2>Certifications</h2></div>
    <div class="cert-grid">
      {
        certifications.map((c) => (
          <div class="cert">
            <span class="chk">[✓]</span>
            <div>
              <div class="code">{c.code}</div>
              <div class="issuer">{c.issuer}</div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
